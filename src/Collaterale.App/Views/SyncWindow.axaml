<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Collaterale.App.Controls"
        xmlns:vm="using:Collaterale.App.Views"
        x:Class="Collaterale.App.Views.SyncWindow"
        Title="Synchronize folders" Width="720" Height="560" MinWidth="560" MinHeight="400" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,10">
      <TextBlock Text="Synchronize folders" FontSize="21" FontWeight="Bold" />
      <ComboBox x:Name="ModeBox" HorizontalAlignment="Stretch" SelectionChanged="OnModeChanged">
        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding ., Converter={x:Static c:Converters.SyncModeLabel}}" /></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
      <TextBlock x:Name="Summary" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock x:Name="Skipped" Classes="muted" FontSize="12" TextWrapping="Wrap" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Cancel" Click="OnCancel" />
      <Button x:Name="Go" Classes="accent" Content="Synchronize" Padding="20,6" Click="OnGo" />
    </StackPanel>
    <Border Classes="panel">
      <ListBox x:Name="Preview" Padding="6">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:SyncLine">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="{Binding Verb}" Width="110" Foreground="{Binding IsDelete, Converter={x:Static c:Converters.DeleteBrush}}" FontFamily="Cascadia Mono,DejaVu Sans Mono,Menlo,Consolas,monospace" FontSize="12" />
              <TextBlock Text="{Binding Path}" FontFamily="Cascadia Mono,DejaVu Sans Mono,Menlo,Consolas,monospace" FontSize="12" />
              <TextBlock Text="{Binding Reason}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </DockPanel>
</Window>
