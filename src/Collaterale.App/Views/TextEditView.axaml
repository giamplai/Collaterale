<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Collaterale.App.ViewModels"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:c="using:Collaterale.App.Controls"
             x:Class="Collaterale.App.Views.TextEditView"
             x:DataType="vm:TextEditViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
  </UserControl.KeyBindings>
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="8,6" Background="{DynamicResource PanelBrush}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}">
      <WrapPanel>
        <Button Classes="tool" Content="Open…" Click="OnOpen" />
        <Button Classes="tool" Command="{Binding SaveCommand}" ToolTip.Tip="Save (Ctrl+S)" ><c:IconLabel Icon="save" Text="Save" /></Button>
        <Button Classes="tool" Content="Save as…" Click="OnSaveAs" />
        <Rectangle Width="1" Margin="8,4" Fill="{DynamicResource LineBrush}" />
        <ToggleButton Classes="tool" Content="· Whitespace" IsChecked="{Binding ShowWhitespace}" />
        <ToggleButton Classes="tool" Content="↩ Wrap" IsChecked="{Binding WordWrap}" />
        <TextBlock Text="Ctrl+F finds text" Classes="muted" VerticalAlignment="Center" Margin="12,0,0,0" />
      </WrapPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Padding="12,4" Background="{DynamicResource PanelBrush}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LineBrush}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding Info}" Classes="muted" FontSize="12" />
        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}" FontSize="12" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Text="{Binding Status}" Classes="muted" FontSize="12" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
      </DockPanel>
    </Border>
    <Border Classes="panel" Margin="12,8,12,12" ClipToBounds="True">
      <ae:TextEditor x:Name="Editor" FontFamily="Cascadia Mono,JetBrains Mono,Fira Code,DejaVu Sans Mono,Menlo,Consolas,monospace" FontSize="13" ShowLineNumbers="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
    </Border>
  </DockPanel>
</UserControl>
