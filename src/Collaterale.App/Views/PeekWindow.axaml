<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Collaterale.App.Views.PeekWindow"
        Title="Peek" Width="760" Height="520" MinWidth="420" MinHeight="260" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <Button DockPanel.Dock="Bottom" Content="Close" HorizontalAlignment="Right" Margin="0,10,0,0" Click="OnClose" />
    <TextBox x:Name="Body" IsReadOnly="True" AcceptsReturn="True" FontFamily="monospace" FontSize="12" TextWrapping="NoWrap" />
  </DockPanel>
</Window>
